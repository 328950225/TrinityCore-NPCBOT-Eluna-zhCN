###################################################################################################
# STATS LIMITS
#
#    Stats.Limits.Enable
#        Description: Enable or disable stats system.
#        Default:     0 - Disabled

Stats.Limits.Enable = 0

#
#    Stats.Limit.[STAT]
#        Description: Set percentage limit for dodge, parry, block and crit rating.
#        Default:     95.0 (95%)

Stats.Limits.Dodge = 100.0
Stats.Limits.Parry = 100.0
Stats.Limits.Block = 100.0
Stats.Limits.Crit  = 100.0


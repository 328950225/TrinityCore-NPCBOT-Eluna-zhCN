#                     现有的、未被召唤的机器人中克隆而来的。漫游机器人不会保存在数据库中。
#        Note:        漫游机器人会保持所在区域的网格（Grid）处于加载状态，这会增加 CPU 和内存的使用率。
#        Note2:       你必须确保 creature_template 表中至少拥有此数量的、未被召唤的机器人模板。
#        Default:     0 - (禁用)

NpcBot.WanderingBots.Continents.Count = 200

